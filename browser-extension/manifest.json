{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "1.6.23",
  "default_locale": "zh_CN",
  "description": "__MSG_ext_description__",
  "permissions": [
    "tabs",
    "windows",
    "tabGroups",
    "activeTab",
    "debugger",
    "scripting",
    "alarms",
    "offscreen",
    "declarativeNetRequest",
    "management",
    "contentSettings",
    "history",
    "bookmarks",
    "downloads",
    "sessions",
    "topSites",
    "notifications",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "native_dialogs.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "mouse_visual.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cursor-chat.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png"
    },
    "default_popup": "popup.html",
    "default_title": "omnibot"
  }
}
